node_modules/
dist/
static/
.data/
*.log

# editor and OS junk
.DS_Store
._*
Thumbs.db
Desktop.ini

# keep secrets out of the repo: your API key lives in an env var or an
# untracked file, never in a tracked one
.env
.env.*
.envrc
mise.local.toml
*.pem

# Claude Code's project directory: settings.local.json can hold the course
# API key, and this repo goes public when you ship, so that file (and any
# other local-only settings json) stays untracked. But .claude/agents/ and
# .claude/skills/ are part of the tracked harness --- CLAUDE.md's own "Where
# things live" index points at them --- so they're not blanket-excluded.
.claude/settings*.json
