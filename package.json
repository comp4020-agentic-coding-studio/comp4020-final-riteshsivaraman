{
  "name": "store-sim",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "tsx src/server/index.ts",
    "dev": "node scripts/dev.ts",
    "layout": "node scripts/layout-server.ts",
    "sim": "mise exec -- tsx scripts/sim/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "pnpm typecheck && pnpm test",
    "check:evidence": "node scripts/check-evidence.ts",
    "test": "vitest run",
    "test:talk": "vitest run --config vitest.talk.config.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.5",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "better-sqlite3": "^12.4.1",
    "hono": "^4.10.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "tsx": "^4.20.6",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^30.1.0",
    "typescript": "^6.0.3",
    "vite": "^7.1.12",
    "vitest": "^5.0.1"
  },
  "engines": {
    "pnpm": ">=11"
  }
}
